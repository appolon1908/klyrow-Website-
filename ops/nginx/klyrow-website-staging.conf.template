upstream klyrow_website_staging {
    server 127.0.0.1:18111 max_fails=2 fail_timeout=5s;
    keepalive 8;
}

server {
    listen 127.0.0.1:18113;
    server_name staging.klyrow.internal;
    client_max_body_size 128k;
    access_log /var/log/nginx/klyrow-website-staging.access.log;

    location / {
        proxy_pass http://klyrow_website_staging;
        proxy_http_version 1.1;
        proxy_set_header Host klyrow.com;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
