{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klyrow.com/schemas/gitops/release-intent-v1.json",
  "title": "Klyrow Website Release Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "status",
    "source_repository",
    "intent_commit",
    "release_sha",
    "image",
    "sbom_sha256",
    "runtime_paths_sha256",
    "reviewed_pull_requests",
    "staging_evidence_sha256",
    "rollback_evidence_sha256",
    "legal_release_state",
    "created_at",
    "created_by"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "environment": { "const": "production" },
    "status": { "enum": ["draft", "approved", "retired"] },
    "source_repository": { "const": "appolon1908-hue/klyrow-Website" },
    "intent_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "release_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "image": {
      "type": "string",
      "pattern": "^ghcr\\.io/appolon1908-hue/klyrow-website@sha256:[a-f0-9]{64}$"
    },
    "sbom_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtime_paths_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviewed_pull_requests": {
      "type": "array",
      "minItems": 14,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "head_sha", "approved"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "head_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "approved": { "const": true }
        }
      }
    },
    "staging_evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rollback_evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "legal_release_state": { "enum": ["approved", "approved_exception"] },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 },
    "change_id": { "type": ["string", "null"], "maxLength": 200 },
    "notes": { "type": "string", "maxLength": 4000 }
  }
}
