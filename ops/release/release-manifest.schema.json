{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klyrow.com/schemas/website-release-manifest.json",
  "title": "Klyrow Website Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_sha",
    "image",
    "image_digest",
    "source_repository",
    "created_at",
    "reviewed_pull_requests",
    "sbom",
    "previous_release_sha"
  ],
  "properties": {
    "release_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "image": { "type": "string", "minLength": 1 },
    "image_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source_repository": { "const": "appolon1908-hue/klyrow-Website-" },
    "created_at": { "type": "string", "format": "date-time" },
    "reviewed_pull_requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "head_sha", "reviewed"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "head_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "reviewed": { "const": true }
        }
      }
    },
    "sbom": { "type": "string", "minLength": 1 },
    "provenance": { "type": "string" },
    "previous_release_sha": { "type": "string", "pattern": "^(|[a-f0-9]{40})$" },
    "migration_statement": { "type": "string", "default": "none" },
    "notes": { "type": "string" }
  }
}
