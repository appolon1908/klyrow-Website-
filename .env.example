NODE_ENV=production
NUXT_PUBLIC_RELEASE_SHA=development
NUXT_PUBLIC_PUBLIC_BASE_URL=https://klyrow.com
NUXT_PUBLIC_SIGN_IN_URL=
NUXT_PUBLIC_DOCS_URL=
NUXT_PUBLIC_STATUS_URL=
NUXT_PUBLIC_SCHEDULING_URL=
NUXT_PUBLIC_PRICING_MODE=contact_sales
NUXT_MIDDLEWARE_MODE=mock
NUXT_MIDDLEWARE_BASE_URL=
NUXT_MIDDLEWARE_EVENT_PATH=/v1/events/website
NUXT_MIDDLEWARE_API_KEY_FILE=/run/secrets/klyrow_middleware_api_key
NUXT_MIDDLEWARE_CLIENT_CERT_FILE=/run/secrets/klyrow_middleware_client_cert
NUXT_MIDDLEWARE_CLIENT_KEY_FILE=/run/secrets/klyrow_middleware_client_key
NUXT_MIDDLEWARE_CA_FILE=/run/secrets/klyrow_middleware_ca
NUXT_MIDDLEWARE_TIMEOUT_MS=5000
NUXT_MIDDLEWARE_MAX_RETRIES=2
